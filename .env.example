# ── ParkingPro PWA — Variables de Entorno ──

# Modalidad de despliegue: remote | local | hybrid
# En modo "local", Supabase no es requerido (las llamadas RPC van por Express)
VITE_DEPLOYMENT_MODE=remote

# Backend API URL
VITE_API_URL=http://localhost:3000

# Socket.IO URL (real-time updates)
VITE_SOCKET_URL=http://localhost:3000

# Supabase (requerido en modo remote/hybrid, opcional en local)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
